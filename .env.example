# modula-server configuration (copy to .env for local dev; never commit .env).
MODULA_DATABASE_URL=postgres://modula:modula@127.0.0.1:55432/modula
MODULA_REDIS_URL=redis://:modula@127.0.0.1:56379
# The only origin the dashboard is served from. https required except for localhost.
MODULA_PUBLIC_URL=http://localhost:7100
MODULA_LISTEN=127.0.0.1:7100
# Create with: modula-server keygen --out ./dev-master.key   (mode 0600; back it up)
MODULA_MASTER_KEY_FILE=./dev-master.key
# Peers allowed to set X-Forwarded-For (the local Caddy).
MODULA_TRUSTED_PROXIES=127.0.0.1,::1
MODULA_LOG=info,sqlx=warn
# Node endpoint (gRPC + mTLS) that modula-node dials. Never the browser port.
MODULA_NODE_LISTEN=127.0.0.1:7101
# Address put into join commands and the endpoint's certificate
# (defaults to https://<public host>:<node port>).
# MODULA_NODE_URL=https://deploy.example.com:7101
